# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/career_copilot
JWT_SECRET=change-this-to-a-long-random-string

# ── App URLs ───────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Email (optional — falls back to console.log in dev) ───────────────────────
# Get a free API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Career Copilot <noreply@yourdomain.com>

# ── Google OAuth (optional) ────────────────────────────────────────────────────
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add Authorized redirect URI: http://localhost:4000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth (optional) ────────────────────────────────────────────────────
# 1. Go to https://github.com/settings/developers → New OAuth App
# 2. Set Authorization callback URL: http://localhost:4000/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
